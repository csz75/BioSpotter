{
	"inputs": [
		{
			"type": "promptString",
			"id": "supabase-access-token",
			"description": "Supabase personal access token (from https://supabase.com/dashboard/account/tokens)",
			"password": true
		}
	],
	"servers": {
		"supabase": {
			"command": "npx",
			"args": [
				"-y",
				"@supabase/mcp-server-supabase@latest",
				"--read-only",
				"--project-ref=cydllxgujiavuenxbhzz"
			],
			"env": {
				"SUPABASE_ACCESS_TOKEN": "${input:supabase-access-token}"
			}
		}
	}
}
